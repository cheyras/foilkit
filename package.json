{
  "name": "foilkit",
  "version": "0.0.0",
  "private": true,
  "description": "A dataset with a renderer attached — trading-card foil measurements and the WebGL renderer that makes them visible.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "tsc --build --force tsconfig.build.json && tsc --noEmit -p tsconfig.tools.json",
    "test": "node --conditions source --test \"packages/*/src/__tests__/*.test.ts\" \"tools/rectifier/*.test.ts\"",
    "reuse": "reuse lint",
    "test:packages": "node --conditions source --test \"packages/*/src/__tests__/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/three": "^0.185.0",
    "react": "^19.1.0",
    "three": "^0.185.1",
    "typescript": "^5.9.2",
    "@foilkit/core": "workspace:*",
    "@foilkit/patterns": "workspace:*",
    "@foilkit/resolver": "workspace:*",
    "@foilkit/forge": "workspace:*",
    "@foilkit/three": "workspace:*"
  }
}
