{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build && pnpm --filter foilkit-editor run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "apps/editor/dist",
  "framework": null,
  "functions": {
    "api/**/*.ts": {
      "runtime": "@vercel/node@5.3.24",
      "memory": 1024,
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|assets/|catalog/|search/|foil-masks/|foil-canon/|foil-windows/|corpus-manifest\\.json|foil-verification-map\\.json|foil-pattern-cards\\.json|bake-receipt\\.json|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/foil-masks/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/(catalog|search)/(.*)",
      "headers": [{ "key": "cache-control", "value": "public, max-age=600, must-revalidate" }]
    },
    {
      "source": "/(corpus-manifest|foil-verification-map|foil-pattern-cards|bake-receipt).json",
      "headers": [{ "key": "cache-control", "value": "public, max-age=300, must-revalidate" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" },
        { "key": "x-frame-options", "value": "DENY" }
      ]
    }
  ]
}
