# Python bytecode from reference/pipeline/*.py
__pycache__/

# The stage acceptance run's screenshots and report — regenerated by
# `pnpm run acceptance`, and a screenshot is an artifact rather than a source.
apps/demo/.acceptance/

# The hosted editor's build output and the synthetic bake it is testable
# against. The REAL bake (data/catalog, data/search, the two resolver files) IS
# committed — Vercel builds from git, so an unbaked artifact there is a missing
# file rather than a stale one.
apps/editor/dist/
data/fixture-bake/
apps/editor/e2e/last-run.json
apps/editor/e2e/failure.png

# The Vercel link (`.vercel/project.json`) and the BUILT DEPLOYMENT
# (`.vercel/output`), which `pnpm run build:vercel` regenerates and
# `tools/verify-functions.mts` boots. Build output, never source.
.vercel
.env*
